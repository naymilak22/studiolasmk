# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed to open /admin (also stored on profiles.role)
ADMIN_EMAILS=

# Resend — https://resend.com/api-keys
# Until a sending domain is verified, use onboarding@resend.dev.
# In that mode Resend delivers only to the email on the Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Studio Las MK <onboarding@resend.dev>
# Leave empty to notify every address in ADMIN_EMAILS.
# While testing without a domain, set this to the Resend account email.
ADMIN_NOTIFICATION_EMAIL=

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
